+
+func TestMemoryNotificationCoalescesOneLogicalTurn(t *testing.T) {
+	cfg := config.DefaultConfig()
+	cfg.Memory.Notifications = config.MemoryNotificationVerbose
+	messageBus := bus.NewMessageBus()
+	al := &AgentLoop{cfg: cfg, bus: messageBus}
+	caller := memory.CallerScope{
+		AgentID: "main", Channel: "telegram", Account: "personal",
+		ChatID: "user-a", UserKey: "telegram:user-a", SessionKey: "session-a",
+	}
+	first := tools.MemoryChangeEvent{
+		Caller: caller, Target: memory.CuratedTargetCurrentUser, TurnID: "turn-1",
+		Result: memory.CuratedBatchResult{
+			Applied: []memory.CuratedEntry{{
+				ID: "mem_0000000000000001", Content: "Prefers concise replies",
+				PreferenceKey: "communication.verbosity", PreferenceValue: "concise",
+				Visibility: memory.CuratedVisibilityBehavioral,
+			}},
+			Outcomes: []memory.CuratedMutationOutcome{{
+				Status: memory.CuratedOutcomeAdded, EntryID: "mem_0000000000000001",
+				PreferenceKey: "communication.verbosity", Visibility: memory.CuratedVisibilityBehavioral,
+			}},
+		},
+	}
+	second := first
+	second.Result = memory.CuratedBatchResult{
+		Applied: []memory.CuratedEntry{{
+			ID: "mem_0000000000000002", Content: "Prefers Native Quiz",
+			PreferenceKey: "workflow.quiz_format", PreferenceValue: "telegram_native_quiz",
+			Visibility: memory.CuratedVisibilityBehavioral,
+		}},
+		Outcomes: []memory.CuratedMutationOutcome{{
+			Status: memory.CuratedOutcomeAdded, EntryID: "mem_0000000000000002",
+			PreferenceKey: "workflow.quiz_format", Visibility: memory.CuratedVisibilityBehavioral,
+		}},
+	}
+
+	al.memoryChangeNotification(context.Background(), first)
+	al.memoryChangeNotification(context.Background(), second)
+	select {
+	case outbound := <-messageBus.OutboundChan():
+		t.Fatalf("notification published before turn finalization: %#v", outbound)
+	default:
+	}
+
+	al.flushMemoryTurnNotification("turn-1")
+	select {
+	case outbound := <-messageBus.OutboundChan():
+		if !strings.Contains(outbound.Content, "Memory updated") {
+			t.Fatalf("unexpected coalesced notification: %q", outbound.Content)
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("coalesced notification was not published")
+	}
+
+	// A delayed reviewer mutation for the same logical turn must not produce a
+	// second visible notification after the turn has been finalized.
+	al.memoryChangeNotification(context.Background(), first)
+	al.flushMemoryTurnNotification("turn-1")
+	select {
+	case outbound := <-messageBus.OutboundChan():
+		t.Fatalf("duplicate logical-turn notification: %#v", outbound)
+	case <-time.After(50 * time.Millisecond):
+	}
+}
+
+func TestMemoryNotificationNoOpDoesNotPublish(t *testing.T) {
+	cfg := config.DefaultConfig()
+	messageBus := bus.NewMessageBus()
+	al := &AgentLoop{cfg: cfg, bus: messageBus}
+	al.memoryChangeNotification(context.Background(), tools.MemoryChangeEvent{
+		Caller: memory.CallerScope{AgentID: "main", Channel: "telegram", ChatID: "user-a"},
+		Target: memory.CuratedTargetCurrentUser, TurnID: "turn-noop",
+		Result: memory.CuratedBatchResult{Outcomes: []memory.CuratedMutationOutcome{{Status: memory.CuratedOutcomeNoOp}}},
+	})
+	al.flushMemoryTurnNotification("turn-noop")
+	select {
+	case outbound := <-messageBus.OutboundChan():
+		t.Fatalf("no-op emitted notification: %#v", outbound)
+	case <-time.After(50 * time.Millisecond):
+	}
+}
