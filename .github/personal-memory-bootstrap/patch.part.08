+func outcomesForAppliedMutations(mutations []CuratedMutation, applied []CuratedEntry) []CuratedMutationOutcome {
+	outcomes := make([]CuratedMutationOutcome, 0, len(mutations))
+	for i, mutation := range mutations {
+		status := CuratedOutcomeUpdated
+		switch mutation.Action {
+		case CuratedActionAdd:
+			status = CuratedOutcomeAdded
+			if mutation.Supersedes != "" {
+				status = CuratedOutcomeSuperseded
+			}
+		case CuratedActionReplace:
+			status = CuratedOutcomeUpdated
+		case CuratedActionRemove:
+			status = CuratedOutcomeRemoved
+		case CuratedActionPin:
+			status = CuratedOutcomePinned
+		case CuratedActionUnpin:
+			status = CuratedOutcomeUnpinned
+		case CuratedActionArchive:
+			status = CuratedOutcomeArchived
+		case CuratedActionRestore:
+			status = CuratedOutcomeRestored
+		}
+		visibility := mutation.Visibility
+		if visibility == "" {
+			for _, entry := range applied {
+				if entry.ID == mutation.ID {
+					visibility = entry.Visibility
+					break
+				}
+			}
+		}
+		outcomes = append(outcomes, CuratedMutationOutcome{
+			MutationIndex: i, Status: status, EntryID: mutation.ID,
+			PreferenceKey: mutation.PreferenceKey, Visibility: visibility,
+		})
+	}
+	return outcomes
 }
 
