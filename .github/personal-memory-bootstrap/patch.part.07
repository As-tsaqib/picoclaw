+// normalizePreferenceUpserts enforces one effective structured preference per
+// key before capacity projection and write. The caller already owns the
+// cross-instance document lock, so concurrent foreground/reviewer attempts are
+// serialized against the latest persisted state.
+func normalizePreferenceUpserts(
+	entries []CuratedEntry,
+	mutations []CuratedMutation,
+) ([]CuratedMutation, []CuratedMutationOutcome) {
+	working := cloneCuratedEntries(entries)
+	effective := make([]CuratedMutation, 0, len(mutations))
+	outcomes := make([]CuratedMutationOutcome, 0)
+	for mutationIndex, mutation := range mutations {
+		if mutation.Action != CuratedActionAdd || NormalizePreferenceKey(mutation.PreferenceKey) == "" {
+			effective = append(effective, mutation)
+			continue
+		}
+		key := NormalizePreferenceKey(mutation.PreferenceKey)
+		idx := activePreferenceEntryIndex(working, key)
+		if idx < 0 {
+			effective = append(effective, mutation)
+			working = append(working, CuratedEntry{
+				ID: mutation.ID, Status: CuratedStatusActive, PreferenceKey: key,
+				PreferenceValue: strings.TrimSpace(mutation.PreferenceValue), EvidenceKind: mutation.EvidenceKind,
+			})
+			continue
+		}
+		existing := normalizedCuratedEntry(working[idx])
+		incomingAuthority := evidenceAuthorityForKind(mutation.EvidenceKind)
+		if strings.TrimSpace(existing.PreferenceValue) == strings.TrimSpace(mutation.PreferenceValue) {
+			if incomingAuthority > existing.EvidenceAuthority() {
+				// Upgrade evidence in place instead of creating a duplicate logical
+				// preference. Preserve the established compact content/ID.
+				mutation.Action = CuratedActionReplace
+				mutation.ID = existing.ID
+				mutation.Content = existing.Content
+				mutation.Type = existing.EffectiveType()
+				mutation.Visibility = existing.EffectiveVisibility(CuratedTargetCurrentUser)
+				mutation.PreferenceKey = key
+				mutation.PreferenceValue = existing.PreferenceValue
+				effective = append(effective, mutation)
+				working[idx].EvidenceKind = mutation.EvidenceKind
+				continue
+			}
+			outcomes = append(outcomes, CuratedMutationOutcome{
+				MutationIndex: mutationIndex, Status: CuratedOutcomeNoOp, EntryID: existing.ID,
+				PreferenceKey: key, Visibility: existing.EffectiveVisibility(CuratedTargetCurrentUser),
+			})
+			continue
+		}
+		if incomingAuthority < existing.EvidenceAuthority() {
+			outcomes = append(outcomes, CuratedMutationOutcome{
+				MutationIndex: mutationIndex, Status: CuratedOutcomeNoOp, EntryID: existing.ID,
+				PreferenceKey: key, Visibility: existing.EffectiveVisibility(CuratedTargetCurrentUser),
+			})
+			continue
+		}
+		if mutation.Supersedes == "" {
+			mutation.Supersedes = existing.ID
+		}
+		effective = append(effective, mutation)
+		working[idx].Status = CuratedStatusSuperseded
+		working = append(working, CuratedEntry{
+			ID: mutation.ID, Status: CuratedStatusActive, PreferenceKey: key,
+			PreferenceValue: mutation.PreferenceValue, EvidenceKind: mutation.EvidenceKind,
+		})
+	}
+	return effective, outcomes
+}
+
+func activePreferenceEntryIndex(entries []CuratedEntry, key string) int {
+	key = NormalizePreferenceKey(key)
+	for i := range entries {
+		if entries[i].EffectiveStatus() == CuratedStatusActive &&
+			NormalizePreferenceKey(entries[i].PreferenceKey) == key {
+			return i
+		}
+	}
+	return -1
+}
+
+func evidenceAuthorityForKind(kind string) int {
+	return (CuratedEntry{EvidenceKind: NormalizeEvidenceKind(kind)}).EvidenceAuthority()
+}
