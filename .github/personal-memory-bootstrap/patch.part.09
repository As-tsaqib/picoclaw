+// HasCanonicalUserMemory reports whether the runtime resolved a canonical
+// authenticated user. Unlike AllowsPrivateUserMemory, it remains true in a
+// trusted group/topic context: the owner is still the sender, while visibility
+// policy controls which entries may enter that shared model context.
+func HasCanonicalUserMemory(caller CallerScope) bool {
+	return strings.TrimSpace(caller.UserKey) != ""
+}
+
+// IsSharedMemoryContext reports whether output for this turn is visible to
+// other participants. GroupID deliberately represents the enclosing shared
+// conversation independently from UserKey, which continues to identify the
+// sender who owns current_user memory.
+func IsSharedMemoryContext(caller CallerScope) bool {
+	return strings.TrimSpace(caller.GroupID) != ""
+}
+
 // Provenance records where a curated fact came from without retaining a full
 // transcript. Source is a compact category such as user_request, agent, or
 // background_review.
