+	var wg sync.WaitGroup
+	for i := 0; i < workers; i++ {
+		store := first
+		if i%2 == 1 {
+			store = second
+		}
+		value := "concise"
+		if i%3 == 0 {
+			value = "detailed"
+		}
+		wg.Add(1)
+		go func(store *CuratedStore, value string) {
+			defer wg.Done()
+			<-start
+			_, err := store.ApplyBatch(CuratedTargetCurrentUser, caller, []CuratedMutation{{
+				Action: CuratedActionAdd, Content: "Explicit verbosity preference: " + value,
+				Type: CuratedTypeCommunicationPreference, EvidenceKind: CuratedEvidenceExplicit,
+				PreferenceKey: "communication.verbosity", PreferenceValue: value,
+			}}, false)
+			errs <- err
+		}(store, value)
+	}
+	close(start)
+	wg.Wait()
+	close(errs)
+	for err := range errs {
+		if err != nil {
+			t.Fatalf("concurrent preference upsert failed: %v", err)
+		}
+	}
+
+	entries, err := first.List(CuratedTargetCurrentUser, caller)
+	if err != nil {
+		t.Fatal(err)
+	}
+	active := 0
+	for _, entry := range entries {
+		if entry.PreferenceKey == "communication.verbosity" && entry.EffectiveStatus() == CuratedStatusActive {
+			active++
+		}
+	}
+	if active != 1 {
+		t.Fatalf("effective same-key states = %d, want 1; entries=%#v", active, entries)
+	}
+}
+
+func TestSharedContextLegacyVisibilityDefaultsFailPrivateExceptBehavioralPreferences(t *testing.T) {
+	group := testCaller("telegram:user-visibility")
+	group.GroupID = "group-1"
+	group.ChatID = "group-1/9"
+	behavioral := normalizedCuratedEntryForTarget(CuratedTargetCurrentUser, CuratedEntry{
+		PreferenceKey: "communication.verbosity", PreferenceValue: "concise",
+	})
+	private := normalizedCuratedEntryForTarget(CuratedTargetCurrentUser, CuratedEntry{Type: CuratedTypeIdentity})
+	if behavioral.Visibility != CuratedVisibilityBehavioral ||
+		!CuratedEntryVisibleInContext(CuratedTargetCurrentUser, group, behavioral) {
+		t.Fatalf("legacy behavioral preference visibility = %#v", behavioral)
+	}
+	if private.Visibility != CuratedVisibilityPrivate ||
+		CuratedEntryVisibleInContext(CuratedTargetCurrentUser, group, private) {
+		t.Fatalf("legacy private entry visibility = %#v", private)
+	}
+}
