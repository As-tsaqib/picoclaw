-func (al *AgentLoop) memoryChangeNotification(ctx context.Context, event tools.MemoryChangeEvent) {
+const maxRememberedMemoryNotifications = 512
+
+type memoryTurnNotificationState struct {
+	mu         sync.Mutex
+	caller     memory.CallerScope
+	target     string
+	result     memory.CuratedBatchResult
+	finalized  bool
+	lastAccess uint64
+}
+
+// memoryChangeNotification accumulates successful logical changes by turn.
+// Foreground delivery and the bounded reviewer explicitly flush the turn, so
+// multiple memory_manage calls can never emit multiple visible notifications.
+func (al *AgentLoop) memoryChangeNotification(_ context.Context, event tools.MemoryChangeEvent) {
+	if al == nil || !event.Result.Changed() {
+		return
+	}
+	turnID := strings.TrimSpace(event.TurnID)
+	if turnID == "" {
+		// Non-turn callers cannot participate in logical-turn coalescing. Keep
+		// backward-compatible notification behavior without retaining orphaned
+		// transaction state. Live turns and the reviewer always provide TurnID.
+		al.publishMemoryChangeNotification(event)
+		return
+	}
+	access := al.memoryNotificationClock.Add(1)
+	value, _ := al.memoryNotifications.LoadOrStore(turnID, &memoryTurnNotificationState{
+		caller: event.Caller, target: event.Target, lastAccess: access,
+	})
+	state, ok := value.(*memoryTurnNotificationState)
+	if !ok || state == nil {
+		return
+	}
+	state.mu.Lock()
+	if state.finalized {
+		state.lastAccess = access
+		state.mu.Unlock()
+		return
+	}
+	state.lastAccess = access
+	if state.caller.Channel == "" {
+		state.caller = event.Caller
+	}
+	if state.target == "" {
+		state.target = event.Target
+	} else if state.target != event.Target {
+		state.target = "mixed"
+	}
+	state.result.Applied = append(state.result.Applied, event.Result.Applied...)
+	state.result.Outcomes = append(state.result.Outcomes, event.Result.Outcomes...)
+	if event.Result.Pending != nil {
+		if state.result.Pending == nil {
+			copyPending := *event.Result.Pending
+			copyPending.Mutations = append([]memory.CuratedMutation(nil), event.Result.Pending.Mutations...)
+			state.result.Pending = &copyPending
+		} else {
+			state.result.Pending.Mutations = append(state.result.Pending.Mutations, event.Result.Pending.Mutations...)
+		}
+	}
+	state.mu.Unlock()
+	al.trimMemoryNotificationStates()
+}
+
+func (al *AgentLoop) flushMemoryTurnNotification(turnID string) {
+	if al == nil {
+		return
+	}
+	turnID = strings.TrimSpace(turnID)
+	if turnID == "" {
+		return
+	}
+	value, ok := al.memoryNotifications.Load(turnID)
+	if !ok {
+		return
+	}
+	state, ok := value.(*memoryTurnNotificationState)
+	if !ok || state == nil {
+		return
+	}
+	state.mu.Lock()
+	if state.finalized {
+		state.mu.Unlock()
+		return
+	}
+	state.finalized = true
+	state.lastAccess = al.memoryNotificationClock.Add(1)
+	event := tools.MemoryChangeEvent{Caller: state.caller, Target: state.target, Result: state.result, TurnID: turnID}
+	state.mu.Unlock()
+	al.publishMemoryChangeNotification(event)
+	al.trimMemoryNotificationStates()
+}
+
+func (al *AgentLoop) trimMemoryNotificationStates() {
+	if al == nil {
+		return
+	}
+	al.memoryNotificationsMu.Lock()
+	defer al.memoryNotificationsMu.Unlock()
+	count := 0
+	oldestKey := ""
+	oldestAccess := ^uint64(0)
+	al.memoryNotifications.Range(func(key, value any) bool {
+		count++
+		state, ok := value.(*memoryTurnNotificationState)
+		if !ok || state == nil {
+			return true
+		}
+		state.mu.Lock()
+		access := state.lastAccess
+		finalized := state.finalized
+		state.mu.Unlock()
+		if finalized && access < oldestAccess {
+			oldestAccess = access
+			oldestKey, _ = key.(string)
+		}
+		return true
+	})
+	if count > maxRememberedMemoryNotifications && oldestKey != "" {
+		al.memoryNotifications.Delete(oldestKey)
+	}
+}
+
