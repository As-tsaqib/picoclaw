+			if inspectErr != nil || entry.EffectiveVisibility(memory.CuratedTargetCurrentUser) != memory.CuratedVisibilityBehavioral {
+				t.Fatalf("shared-chat staged non-behavioral usage: %#v, err=%v", usage, inspectErr)
+			}
 		}
 	}
 }
