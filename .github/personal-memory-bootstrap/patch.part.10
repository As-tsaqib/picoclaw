+	if len(r.Applied) > 0 && len(r.Outcomes) == 0 {
+		// Backward-compatible structural result from non-upgraded internal callers.
+		return true
+	}
+	for _, outcome := range r.Outcomes {
+		switch outcome.Status {
+		case CuratedOutcomeAdded, CuratedOutcomeUpdated, CuratedOutcomeSuperseded,
+			CuratedOutcomeRemoved, CuratedOutcomePinned, CuratedOutcomeUnpinned,
+			CuratedOutcomeArchived, CuratedOutcomeRestored:
+			return true
+		}
+	}
+	return false
+}
+
+// VisibleToCaller returns a model-safe result. A shared group/topic may write
+// private current-user memory for its authenticated sender, but write/read
+// results must not re-inject that private content into the shared model prompt.
+func (r CuratedBatchResult) VisibleToCaller(target string, caller CallerScope) CuratedBatchResult {
+	if !strings.EqualFold(strings.TrimSpace(target), CuratedTargetCurrentUser) ||
+		!IsSharedMemoryContext(caller) {
+		return r
+	}
+	out := r
+	out.Applied = make([]CuratedEntry, 0, len(r.Applied))
+	for _, entry := range r.Applied {
+		if entry.EffectiveVisibility(CuratedTargetCurrentUser) == CuratedVisibilityBehavioral {
+			out.Applied = append(out.Applied, entry)
+		}
+	}
+	if r.Pending != nil {
+		pending := *r.Pending
+		pending.Mutations = append([]CuratedMutation(nil), r.Pending.Mutations...)
+		for i := range pending.Mutations {
+			if NormalizeCuratedVisibility(pending.Mutations[i].Visibility) == CuratedVisibilityBehavioral {
+				continue
+			}
+			pending.Mutations[i].ID = ""
+			pending.Mutations[i].Content = ""
+			pending.Mutations[i].PreferenceKey = ""
+			pending.Mutations[i].PreferenceValue = ""
+			pending.Mutations[i].Supersedes = ""
+			pending.Mutations[i].Provenance = Provenance{}
+		}
+		out.Pending = &pending
+	}
+	out.Conflicts = nil
+	out.Outcomes = append([]CuratedMutationOutcome(nil), r.Outcomes...)
+	for i := range out.Outcomes {
+		if NormalizeCuratedVisibility(out.Outcomes[i].Visibility) == CuratedVisibilityBehavioral {
+			continue
+		}
+		out.Outcomes[i].EntryID = ""
+		out.Outcomes[i].PreferenceKey = ""
+	}
+	return out
 }
 
 // CuratedConflict is a bounded, non-destructive near-duplicate hint. It lets
diff -ruN /mnt/data/picoclaw-personal-memory-base/picoclaw-main/pkg/memory/personal_memory_invariants_test.go /mnt/data/picoclaw-personal-memory-work/pkg/memory/personal_memory_invariants_test.go
