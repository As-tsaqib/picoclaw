 }
 
+func NormalizeCuratedVisibility(value string) string {
+	value = strings.ToLower(strings.TrimSpace(value))
+	if _, ok := curatedVisibilities[value]; ok {
+		return value
+	}
+	return ""
+}
+
+func ValidCuratedVisibility(value string) bool {
+	_, ok := curatedVisibilities[strings.ToLower(strings.TrimSpace(value))]
+	return ok
+}
+
+// EffectiveVisibility gives legacy entries a conservative deterministic
+// classification. Workspace entries are shared by definition. Current-user
+// identity/private facts remain private, while known interaction preferences
+// are behavioral and may safely influence the same user's behavior in groups.
+func (entry CuratedEntry) EffectiveVisibility(target string) string {
+	if visibility := NormalizeCuratedVisibility(entry.Visibility); visibility != "" {
+		return visibility
+	}
+	if strings.EqualFold(strings.TrimSpace(target), CuratedTargetWorkspace) {
+		return CuratedVisibilityShared
+	}
+	if behavioralPreferenceEntry(entry) {
+		return CuratedVisibilityBehavioral
+	}
+	return CuratedVisibilityPrivate
+}
+
+func CuratedEntryVisibleInContext(target string, caller CallerScope, entry CuratedEntry) bool {
+	if !strings.EqualFold(strings.TrimSpace(target), CuratedTargetCurrentUser) {
+		return true
+	}
+	if !IsSharedMemoryContext(caller) {
+		return true
+	}
+	return entry.EffectiveVisibility(CuratedTargetCurrentUser) == CuratedVisibilityBehavioral
+}
+
+func behavioralPreferenceEntry(entry CuratedEntry) bool {
+	key := NormalizePreferenceKey(entry.PreferenceKey)
+	if key == "" {
+		return false
+	}
+	for _, prefix := range []string{
+		"communication.", "workflow.", "formatting.", "coding.", "language.", "tooling.",
+		"interaction.", "boundary.", "boundaries.",
+	} {
+		if strings.HasPrefix(key, prefix) {
+			return true
+		}
+	}
+	return false
+}
+
+func defaultVisibilityForMutation(target string, mutation CuratedMutation) string {
+	if strings.EqualFold(strings.TrimSpace(target), CuratedTargetWorkspace) {
+		return CuratedVisibilityShared
+	}
+	entry := CuratedEntry{
+		Type:            mutation.Type,
+		PreferenceKey:   mutation.PreferenceKey,
+		PreferenceValue: mutation.PreferenceValue,
+	}
+	return entry.EffectiveVisibility(CuratedTargetCurrentUser)
+}
+
+func visibilityAllowedForTarget(target, visibility string) bool {
+	visibility = NormalizeCuratedVisibility(visibility)
+	if strings.EqualFold(strings.TrimSpace(target), CuratedTargetWorkspace) {
+		return visibility == CuratedVisibilityShared
+	}
+	return visibility == CuratedVisibilityBehavioral || visibility == CuratedVisibilityPrivate
+}
+
