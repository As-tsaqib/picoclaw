 type CuratedBatchResult struct {
-	Applied   []CuratedEntry        `json:"applied,omitempty"`
-	Pending   *PendingCuratedChange `json:"pending,omitempty"`
-	Conflicts []CuratedConflict     `json:"conflicts,omitempty"`
+	Applied   []CuratedEntry           `json:"applied,omitempty"`
+	Pending   *PendingCuratedChange    `json:"pending,omitempty"`
+	Conflicts []CuratedConflict        `json:"conflicts,omitempty"`
+	Outcomes  []CuratedMutationOutcome `json:"outcomes,omitempty"`
+}
+
+// CuratedMutationOutcome exposes deterministic mutation semantics without
+// requiring callers to infer them from entry counts. Visibility is retained
+// internally so shared-context tool output can redact private mutation detail.
+type CuratedMutationOutcome struct {
+	MutationIndex int    `json:"mutation_index"`
+	Status        string `json:"status"`
+	EntryID       string `json:"entry_id,omitempty"`
+	PreferenceKey string `json:"preference_key,omitempty"`
+	Visibility    string `json:"visibility,omitempty"`
+}
+
+// Changed reports whether the result persisted a logical state mutation.
+// Reaffirming an identical effective preference and a no-op are intentionally
+// excluded so foreground/reviewer duplicate attempts do not create visible
+// notification spam.
+func (r CuratedBatchResult) Changed() bool {
+	if r.Pending != nil {
+		return true
+	}
