+// duplicateHistoricalPreferenceValue permits a user to return to an older
+// structured preference value even when the compact human-readable content is
+// exactly the same as a superseded historical entry. Active same-value writes
+// are removed earlier by normalizePreferenceUpserts, so this exception cannot
+// create two effective states or bypass generic duplicate protection.
+func duplicateHistoricalPreferenceValue(entries []CuratedEntry, mutation CuratedMutation) bool {
+	key := NormalizePreferenceKey(mutation.PreferenceKey)
+	value := strings.TrimSpace(mutation.PreferenceValue)
+	if key == "" || value == "" {
+		return false
+	}
+	normalizedContent := normalizeCuratedContent(mutation.Content)
+	found := false
+	for _, entry := range entries {
+		if normalizeCuratedContent(entry.Content) != normalizedContent {
+			continue
+		}
+		found = true
+		if entry.EffectiveStatus() == CuratedStatusActive ||
+			NormalizePreferenceKey(entry.PreferenceKey) != key ||
+			strings.TrimSpace(entry.PreferenceValue) != value {
+			return false
+		}
+	}
+	return found
+}
