+var curatedVisibilities = map[string]struct{}{
+	CuratedVisibilityBehavioral: {},
+	CuratedVisibilityPrivate:    {},
+	CuratedVisibilityShared:     {},
+}
+
 func NormalizeCuratedType(value string) string {
 	value = strings.ToLower(strings.TrimSpace(value))
 	if _, ok := curatedTypes[value]; ok {
@@ -70,6 +76,82 @@
